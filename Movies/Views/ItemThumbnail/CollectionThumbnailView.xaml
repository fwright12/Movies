<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:ext="clr-namespace:Microsoft.Maui.Controls.Extensions;assembly=MauiExtensions"
        xmlns:viewmodels="clr-namespace:Movies.ViewModels"
        x:Class="Movies.Views.CollectionThumbnailView"
        x:DataType="viewmodels:CollectionViewModel"
        Style="{StaticResource PosterStyle}">
    <ext:ImageView Source="{Binding Item.PosterPath}"
                   AltView="{Binding Name}" />
</Border>