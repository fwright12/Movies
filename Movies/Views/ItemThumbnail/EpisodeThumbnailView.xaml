<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:ext="clr-namespace:Microsoft.Maui.Controls.Extensions;assembly=MauiExtensions"
        xmlns:viewmodels="clr-namespace:Movies.ViewModels"
        x:Class="Movies.Views.EpisodeThumbnailView"
        x:DataType="viewmodels:TVEpisodeViewModel"
        ext:VisualElement.AspectRequest="1.778"
        Style="{StaticResource ThumbnailStyle}">
    <Grid>
        <ext:ImageView Source="{Binding PosterPath}"
                       AltView="{Binding Title}" />

        <Label Text="{Binding Title}"
               TextColor="White"
               FontSize="Title"
               HorizontalTextAlignment="End"
               VerticalOptions="End"
               HorizontalOptions="End"
               Padding="10">
            <VisualElement.BackgroundColor>
                <Color>
                    <x:Arguments>
                        <x:Single>0</x:Single>
                        <x:Single>0</x:Single>
                        <x:Single>0</x:Single>
                        <x:Single>0.2</x:Single>
                    </x:Arguments>
                </Color>
            </VisualElement.BackgroundColor>
        </Label>
    </Grid>
</Border>