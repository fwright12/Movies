<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:converters="clr-namespace:Movies.Converters"
                    xmlns:ext="clr-namespace:Microsoft.Maui.Controls.Extensions;assembly=MauiExtensions"
                    xmlns:generic="clr-namespace:System.Collections.Generic;assembly=netstandard"
                    xmlns:maui="clr-namespace:Microsoft.Maui.Controls;assembly=MauiExtensions"
                    xmlns:models="clr-namespace:Movies.Models"
                    xmlns:movies="clr-namespace:Movies"
                    xmlns:strings="clr-namespace:Movies.Resources.Strings"
                    xmlns:templates="clr-namespace:Movies.Templates"
                    xmlns:viewmodels="clr-namespace:Movies.ViewModels"
                    xmlns:views="clr-namespace:Movies.Views"
                    x:Class="Movies.Views.InfoPageResources">
    <DataTemplate x:Key="DefaultTemplate">
        <maui:ExpandableContentView>
            <Label Text="{Binding}"
                   MaxLines="10"
                   Style="{StaticResource ExpandableTextStyle}"
                   IsVisible="{Binding Text, Source={RelativeSource Self}, Converter={Static maui:ObjectToFalseConverter.Instance}, ConverterParameter={Static x:String.Empty}}" />
        </maui:ExpandableContentView>
    </DataTemplate>

    <DataTemplate x:Key="DefaultInfoTemplate">
        <views:LabeledLabel Label="{Binding Label}"
                            Value="{Binding Value}" />
    </DataTemplate>

    <DataTemplate x:Key="ExternalRatingTemplate"
                  x:DataType="models:Rating">
        <Border Style="{StaticResource CardStyle}">
            <View.GestureRecognizers>
                <TapGestureRecognizer CommandParameter="{Binding}">
                    <TapGestureRecognizer.Command>
                        <viewmodels:OpenReviewsCommand>
                            <DataTemplate>
                                <views:ReviewsPage Title="{Binding Company.Name}" />
                            </DataTemplate>
                        </viewmodels:OpenReviewsCommand>
                    </TapGestureRecognizer.Command>
                </TapGestureRecognizer>
            </View.GestureRecognizers>

            <VerticalStackLayout Spacing="5">
                <Label Text="{Binding Company.Name}"
                       FontSize="Small"
                       LineBreakMode="TailTruncation"
                       WidthRequest="{ext:Percent 100}" />

                <HorizontalStackLayout Spacing="5">
                    <Image Source="{Binding Company.LogoPath, Converter={StaticResource DefaultImageSourceConverter}}"
                           MaximumHeightRequest="{ext:Percent 100}"
                           FlexLayout.Grow="1" />

                    <Label Text="{Binding Score}"
                           FontAttributes="Bold"
                           FontSize="Title"
                           TextColor="{AppThemeBinding Light={StaticResource LightPrimaryText}, Dark={StaticResource DarkPrimaryText}}"
                           FlexLayout.Shrink="0" />
                </HorizontalStackLayout>

                <Label Text="{Binding Source={Static strings:AppResources.SeeReviewsText}, StringFormat='{0} >'}"
                       FontSize="Caption"
                       HorizontalTextAlignment="End"
                       LineBreakMode="HeadTruncation"
                       Padding="10,0,0,0"
                       Opacity="{Binding Reviews, Converter={Static viewmodels:NullToBooleanIntConverter.Instance}}" />
            </VerticalStackLayout>
        </Border>
    </DataTemplate>

    <movies:RatingTemplateSelector x:Key="RatingTemplateSelector"
                                   ExternalRatingTemplate="{StaticResource ExternalRatingTemplate}" />

    <DataTemplate x:Key="RatingListTemplate">
        <CollectionView ItemsSource="{Binding}"
                        ItemTemplate="{StaticResource RatingTemplateSelector}"
                        EmptyView="{Static strings:AppResources.RatingListEmptyView}"
                        ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal"
                                   ItemSpacing="5" />
            </CollectionView.ItemsLayout>
        </CollectionView>
    </DataTemplate>

    <DataTemplate x:Key="WatchProviderTemplate"
                  x:DataType="models:WatchProvider">
        <VerticalStackLayout>
            <ext:ImageView Source="{Binding Company.LogoPath}"
                           ext:VisualElement.AspectRequest="1"
                           HorizontalOptions="Center"
                           WidthRequest="33"
                           FlexLayout.Grow="1" />

            <Label Text="{Binding Company.Name}"
                   HorizontalTextAlignment="Center"
                   FlexLayout.Shrink="0"
                   MaximumWidthRequest="100"
                   LineBreakMode="TailTruncation" />
        </VerticalStackLayout>
    </DataTemplate>

    <DataTemplate x:Key="WatchProviderListTemplate">
        <CollectionView ItemsSource="{Binding}"
                        ItemTemplate="{StaticResource WatchProviderTemplate}"
                        IsGrouped="True"
                        EmptyView="{Static strings:AppResources.WatchProvidersEmptyView}">
            <StructuredItemsView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal"
                                   ItemSpacing="10" />
            </StructuredItemsView.ItemsLayout>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Name}"
                           VerticalTextAlignment="Center" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
        </CollectionView>
    </DataTemplate>

    <DataTemplate x:Key="CreditTemplate"
                  x:DataType="models:Credit">
        <VerticalStackLayout>
            <views:PersonThumbnailView BindingContext="{Binding Person, Converter={maui:Converter Type={x:Type movies:ItemViewModelConverter}}}"
                                       FlexLayout.Grow="1" />

            <Label Text="{Binding Role}"
                   FontSize="Small"
                   Style="{StaticResource CaptionStyle}"
                   FlexLayout.Shrink="0" />
        </VerticalStackLayout>
    </DataTemplate>

    <DataTemplate x:Key="CreditListTemplate">
        <CollectionView ItemsSource="{Binding}"
                        ItemTemplate="{StaticResource CreditTemplate}"
                        EmptyView="{OnPlatform Android={Static strings:AppResources.CreditListEmptyView}}"
                        IsGrouped="True">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal"
                                   ItemSpacing="10"
                                   ext:ItemsLayout.ItemLength="100" />
            </CollectionView.ItemsLayout>

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <Label Text="{Binding Name}"
                           VerticalOptions="Center"
                           ext:ItemsLayout.Length="Auto" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
        </CollectionView>
    </DataTemplate>

    <DataTemplate x:Key="CompanyListTemplate">
        <CollectionView ItemsSource="{Binding}"
                        EmptyView="{Static strings:AppResources.CompanyListEmptyView}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal"
                                   ItemSpacing="10"
                                   ext:ItemsLayout.ItemLength="150" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Company">
                    <Border Style="{StaticResource CardStyle}">
                        <views:CompanyThumbnailView />
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </DataTemplate>

    <DataTemplate x:Key="InfoSectionTemplate">
        <views:SectionView Title="{Binding Label}"
                           Style="{StaticResource InfoSectionStyle}" />
    </DataTemplate>

    <DataTemplate x:Key="InfoSubsectionTemplate">
        <StackLayout Orientation="Vertical">
            <Label Text="{Binding Label}"
                   Style="{StaticResource ValueDescriptorStyle}" />
            <ContentView Style="{StaticResource InfoSectionStyle}" />
        </StackLayout>
    </DataTemplate>

    <maui:TypeTemplateSelector x:Key="InfoTemplateSelector">
        <maui:TypeTemplateSelector.Templates>
            <maui:TypeDataTemplate Type="{x:Type viewmodels:CollectionViewModel}"
                                   Template="{DataTemplate views:ItemListCompactView}" />
            <!--<maui:TypeDataTemplate Type="{x:Type ImageSource}"
                                   Template="{StaticResource MediaTemplateSelector}" />-->
            <maui:TypeDataTemplate Type="{x:Type x:String}"
                                   Template="{StaticResource DefaultTemplate}" />

            <maui:TypeDataTemplate Type="{Static views:InfoPageResources.CreditEnumerableType}"
                                   Template="{StaticResource CreditListTemplate}" />
            <maui:TypeDataTemplate Type="{Static views:InfoPageResources.CompanyEnumerableType}"
                                   Template="{StaticResource CompanyListTemplate}" />
            <maui:TypeDataTemplate Type="{Static views:InfoPageResources.RatingEnumerableType}"
                                   Template="{StaticResource RatingListTemplate}" />
            <maui:TypeDataTemplate Type="{Static views:InfoPageResources.WatchProviderEnumerableType}"
                                   Template="{StaticResource WatchProviderListTemplate}" />
        </maui:TypeTemplateSelector.Templates>
    </maui:TypeTemplateSelector>

    <generic:List x:Key="EmptyRatings"
                  x:TypeArguments="models:Rating" />
    <generic:List x:Key="EmptyWatchProviders"
                  x:TypeArguments="viewmodels:Group(models:WatchProvider)" />
    <generic:List x:Key="EmptyCredits"
                  x:TypeArguments="viewmodels:Group(models:Credit)" />
    <generic:List x:Key="EmptyCompanies"
                  x:TypeArguments="models:Company" />

    <Style x:Key="OptionalLabelStyle"
           TargetType="Label">
        <Setter Property="IsVisible"
                Value="{Binding Text, Source={RelativeSource Self}, Converter={Static maui:FalseIfNullConverter.Instance}}" />
    </Style>

    <Style TargetType="views:LabeledLabel"
           BasedOn="{StaticResource BodyLabel}">
        <Setter Property="IsVisible"
                Value="{Binding Value, Source={RelativeSource Self}, Converter={Static maui:FalseIfNullConverter.Instance}}" />
    </Style>

    <Style x:Key="OptionalLayoutStyle"
           TargetType="{Static views:HideIfNoVisibleChildrenBehavior.ViewLayout}">
        <Style.Behaviors>
            <views:HideIfNoVisibleChildrenBehavior />
        </Style.Behaviors>
    </Style>

    <Style x:Key="OptionalContentViewStyle"
           TargetType="ContentView">
        <Setter Property="IsVisible"
                Value="{Binding Content.IsVisible, Source={RelativeSource Self}, FallbackValue='False'}" />
    </Style>

    <DataTemplate x:Key="DefaultEmptyViewTemplate">
        <Label Text="{Binding Title, Source={RelativeSource AncestorType={x:Type views:SectionView}}, StringFormat='{0} not available'}"
               HorizontalTextAlignment="Center"
               Padding="0, 50" />
    </DataTemplate>

    <Style x:Key="InfoSectionStyle"
           TargetType="ContentView"
           BasedOn="{StaticResource OptionalContentViewStyle}">
        <Setter Property="ext:ContentView.ContentTemplate"
                Value="{StaticResource InfoTemplateSelector}" />
    </Style>

    <Style x:Key="InfoSubsectionStyle"
           TargetType="ContentView"
           BasedOn="{StaticResource InfoSectionStyle}">
        <Setter Property="ext:ContentView.ContentTemplate"
                Value="{StaticResource InfoTemplateSelector}" />
        <Setter Property="ControlTemplate">
            <ControlTemplate>
                <FlexLayout Direction="Column">
                    <Label Text="{TemplateBinding Title}"
                           FontSize="Small"
                           Style="{StaticResource ValueDescriptorStyle}"
                           FlexLayout.Shrink="0" />

                    <ContentPresenter FlexLayout.Grow="1" />
                </FlexLayout>
            </ControlTemplate>
        </Setter>
    </Style>

    <maui:MediaTemplateSelector x:Key="MediaTemplateSelector">
        <maui:MediaTemplateSelector.ImageTemplate>
            <DataTemplate>
                <Image Source="{Binding}"
                       Aspect="AspectFill" />
            </DataTemplate>
        </maui:MediaTemplateSelector.ImageTemplate>

        <maui:MediaTemplateSelector.VideoTemplate>
            <DataTemplate>
                <WebView Source="{Binding Converter={StaticResource EmbedVideo}}"
                         WidthRequest="177.778"
                         HeightRequest="100"
                         IsFocused="{Binding IsVideoPlaying, Mode=OneWayToSource, Source={RelativeSource AncestorType={x:Type viewmodels:MediaViewModel}}}" />
            </DataTemplate>
        </maui:MediaTemplateSelector.VideoTemplate>
    </maui:MediaTemplateSelector>

    <ControlTemplate x:Key="BasicInfoTemplate">
        <VerticalStackLayout Spacing="25">
            <views:QuickActionsPanel HorizontalOptions="Center"
                                     IsVisible="{Binding Converter={maui:Converter Type={x:Type movies:QuickActionsAvailableConverter}}}">
                <VisualElement.Triggers>
                    <!--<EventTrigger Event="LayoutChanged">
                        <movies:MoviePaddingTriggerAction />
                    </EventTrigger>-->
                </VisualElement.Triggers>
            </views:QuickActionsPanel>

            <FlexLayout Direction="Row"
                        AlignItems="Start"
                        JustifyContent="Center"
                        Wrap="Wrap">
                <Grid HeightRequest="200"
                      IsVisible="false">
                    <ContentView x:Name="mediaContent"
                                 Content="{ext:ViewBinding PrimaryImagePath, Template={StaticResource MediaTemplateSelector}}"
                                 IsVisible="{Binding Content.IsVisible, Source={RelativeSource Self}}"
                                 Style="{StaticResource OptionalContentViewStyle}"
                                 Margin="0,0,10,10" />

                    <ContentView Content="{ext:ViewBinding Source='Content not available', Template={StaticResource ImageAltViewTemplate}}"
                                 WidthRequest="{Binding Width, Source={x:Reference mediaContent}}" />
                </Grid>

                <ContentPresenter FlexLayout.Grow="1" />
            </FlexLayout>
        </VerticalStackLayout>
    </ControlTemplate>
</ResourceDictionary>