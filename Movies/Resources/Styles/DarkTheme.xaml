<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="PrimaryDark">Black</Color>
    <Color x:Key="PrimaryDarkText">White</Color>

    <Color x:Key="DarkPrimaryBackground">Black</Color>
    <!--Dark Slate Gray (two shades darker)-->
    <Color x:Key="DarkSecondaryBackground">#1F3333</Color>
    <Color x:Key="DarkPrimaryText">White</Color>
    <Color x:Key="DarkSecondaryText">Gray</Color>
</ResourceDictionary>