    <!-- ================================== PAGES ================================== -->

    <Style TargetType="ContentPage"
           x:Key="InfoPageStyle">
        <Setter Property="Title"
                Value="{Binding Name}" />
        <Setter Property="Padding"
                Value="0" />
        <!--<Setter Property="ios:NavigationPage.PrefersLargeTitles"
