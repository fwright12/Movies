    <Setter Property="ios:Page.LargeTitleDisplay"
            Value="Always" />-->
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup Name="MediaPageStates">
                    <VisualState Name="Poster">
                        <VisualState.Setters>
                            <Setter Property="Shell.NavBarIsVisible"
                                    Value="False" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState Name="Details">
                        <VisualState.Setters>
                            <Setter Property="Shell.NavBarIsVisible"
                                    Value="True" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
        <Setter Property="ext:VisualStateManager.VisualState"
                Value="Poster" />
    </Style>

