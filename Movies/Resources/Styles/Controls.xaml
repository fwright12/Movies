    <Style TargetType="VisualElement"
           Class="ShowsNavBarOnScroll"
           ApplyToDerivedTypes="True">
        <Style.Triggers>
            <EventTrigger Event="Scrolled">
                <viewmodels:MediaPageTriggerAction />
            </EventTrigger>
        </Style.Triggers>
    </Style>

