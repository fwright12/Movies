<?xml version="1.0" encoding="utf-8" ?>
<FlexLayout xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
            xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
            x:Class="Movies.SelectableOptionsLayout"
            xmlns:maui="clr-namespace:Microsoft.Maui.Controls;assembly=MauiExtensions"
            xmlns:movies="clr-namespace:Movies"
            Wrap="Wrap">
    <VisualElement.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <movies:PredicateEditorResources />
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Button"
                   BasedOn="{StaticResource SelectableButtonStyle}" />
        </ResourceDictionary>
    </VisualElement.Resources>
</FlexLayout>
